@model IEnumerable<SalonApp2.Models.Appointment>

<h2>Appointments</h2>

<a asp-action="Create" class="btn btn-primary">Create New Appointment</a>

<table class="table">
    <thead>
        <tr>
            <th>AppID</th>
            <th>Date & Time</th>
            <th>Employee</th>
            <th>Client</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.AppID</td>
                <td>@appointment.DateAndTime.ToString("g")</td>
                <td>@appointment.Employee?.Name</td>
                <td>@appointment.Client?.Name</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@appointment.AppID" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@appointment.AppID" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
